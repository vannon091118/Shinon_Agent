#!/usr/bin/env bash
# ═══════════════════════════════════════════════════════════════════════
# shinon-setup — Linux/macOS shim for `python shinon-setup.py`
#
# DEPRECATED in v1.0 — full wizard + Doctor Mous now lives in
# python `shinon-setup.py` (cross-platform). This 5-line wrapper
# just forwards arguments to the Python entry-point.
# ═══════════════════════════════════════════════════════════════════════

set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if command -v python3 >/dev/null 2>&1; then
    exec python3 "$SCRIPT_DIR/shinon-setup.py" "$@"
elif command -v python >/dev/null 2>&1; then
    exec python "$SCRIPT_DIR/shinon-setup.py" "$@"
else
    echo "[FAIL] Python 3.11+ nicht gefunden." >&2
    exit 1
fi
