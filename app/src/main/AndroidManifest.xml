<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.vannon.shinon">

    <!-- App-interne Runtime, kein externer Netzverkehr außer Provider-Aufrufe -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Foreground-Service hält den DSH-Prozess gegen Doze/Background-Kills -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <!-- Android 12+: FOREGROUND_SERVICE_DATA_SYNC-Modus, wenn der
         Foreground-Service Daten synchronisiert (N/A hier, aber
         explizit ab Android 14). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".ShinonApp"
        android:allowBackup="false"
        android:label="Shinon"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.Shinon"
        android:hardwareAccelerated="true">

        <!-- SetupActivity: nur beim allerersten Start (Flag in SharedPreferences) -->
        <activity
            android:name=".SetupActivity"
            android:exported="true"
            android:theme="@style/Theme.Shinon.Setup">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize" />

        <service
            android:name=".ShinonService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />

    </application>

</manifest>
