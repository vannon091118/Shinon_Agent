<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.vannon.shinon">

    <!-- App-interne Runtime, kein externer Netzverkehr außer Provider-Aufrufe -->
    <uses-permission android:name="android.permission.INTERNET" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- dataSync ist der Dienst-Typ des Foreground-Service (siehe <service>);
         die zugehörige Permission verlangt Android ab API 34. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Ab API 33 ist die laufende Dienst-Benachrichtigung nur sichtbar, wenn
         diese Permission erteilt ist. Die Manifest-Deklaration allein genügt
         dort nicht — MainActivity fragt sie zur Laufzeit an. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".ShinonApp"
        android:allowBackup="false"
        android:label="Shinon"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.Shinon"
        android:hardwareAccelerated="true">

        <!-- SetupActivity: nur beim allerersten Start (Flag in SharedPreferences) -->
        <activity
            android:name=".SetupActivity"
            android:exported="true"
            android:theme="@style/Theme.Shinon.Setup">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize" />

        <service
            android:name=".ShinonService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />

    </application>

</manifest>
