<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- WebView: die Weboberfläche der Shinon-Engine (DSH + Mobile-Profil) -->
    <WebView
        android:id="@+id/webview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- Splash-Overlay: läuft bis die tokenisierte READY-URL vom Service kommt -->
    <LinearLayout
        android:id="@+id/splash_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#000000">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Shinon Forge"
            android:textSize="24sp"
            android:textColor="#FFFFFF" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Engine startet…"
            android:textSize="14sp"
            android:textColor="#888888" />
    </LinearLayout>

    <!-- Prototyp-Status: keine Runtime wird vorgetäuscht. -->
    <LinearLayout
        android:id="@+id/error_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="28dp"
        android:visibility="gone"
        android:background="#111111">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Shinon Agent 0.01"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="Prototyp-Shell installiert. Die Node-/DSH-/Forge-Runtime ist in dieser Version noch nicht enthalten. Die Engine kann deshalb noch nicht starten."
            android:textSize="15sp"
            android:lineSpacingExtra="4dp"
            android:textColor="#BBBBBB" />
        <Button
            android:id="@+id/retry_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Runtime erneut prüfen" />
    </LinearLayout>
</FrameLayout>
