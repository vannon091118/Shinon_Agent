#!/usr/bin/env bash
# ═══════════════════════════════════════════════════════════════════════
# shinon — Linux/macOS CLI-Wrapper (thin shim)
#
# Leitet ALLES an shinon.py weiter. Die eigentliche Logik lebt in Python.
# Forward-kompatibel: jedes neue Subcommand in shinon.py funktioniert
# automatisch über diesen Wrapper.
# ═══════════════════════════════════════════════════════════════════════

set -euo pipefail

# Resolve symlinks so `shinon` works even when installed globally as a
# symlink (e.g. ~/.local/bin/shinon -> <project>/shinon).  Plain
# `dirname ${BASH_SOURCE[0]}` would resolve to the symlink's directory,
# NOT the real script location.
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
    DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"

if command -v python3 >/dev/null 2>&1; then
    exec python3 "$SCRIPT_DIR/shinon.py" "$@"
elif command -v python >/dev/null 2>&1; then
    exec python "$SCRIPT_DIR/shinon.py" "$@"
else
    echo "❌ Python 3.11+ nicht gefunden." >&2
    echo "   Installiere Python oder füge es zum PATH hinzu." >&2
    echo "   https://www.python.org/downloads/" >&2
    exit 1
fi
