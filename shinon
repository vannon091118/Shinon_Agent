#!/usr/bin/env bash
# ═══════════════════════════════════════════════════════════════════════
# shinon — Control Plane CLI Entry Point
#
# Vereint Start/Stop, Onboarding, Diagnose und Chat unter einem Befehl.
#
# Usage:
#   ./shinon                     Zeigt Hilfe
#   ./shinon start               Startet alle Komponenten
#   ./shinon stop                Stoppt alle Komponenten
#   ./shinon status              Zeigt Komponenten-Status
#   ./shinon chat                Öffnet die Chat-Oberfläche
#   ./shinon --setup             Startet den Onboarding-Wizard
#   ./shinon --doc               Doctor Mous · Diagnose + Reparatur
#   ./shinon dashboard           Öffnet das Live-Dashboard
#   ./shinon keys                API-Key-Management
# ═══════════════════════════════════════════════════════════════════════

set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CONFIG_DIR="$HOME/.config/shinon"

# ─── Farben ──────────────────────────────────────────────────────────
RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'
CYAN='\033[0;36m'; BOLD='\033[1m'; NC='\033[0m'

# ─── First-Run-Erkennung ────────────────────────────────────────────
if [[ ! -f "$CONFIG_DIR/.install-done" ]]; then
    echo -e "\n${YELLOW}╔══════════════════════════════════════════════════════════╗${NC}"
    echo -e "${YELLOW}║  ⚠️  Shinon ist noch nicht installiert.                  ║${NC}"
    echo -e "${YELLOW}║                                                          ║${NC}"
    echo -e "${YELLOW}║  Starte Installation:                                    ║${NC}"
    echo -e "${YELLOW}║    bash install.sh                                       ║${NC}"
    echo -e "${YELLOW}╚══════════════════════════════════════════════════════════╝${NC}"
    echo ""
    read -rp "  Jetzt installieren? (J/n): " DO_INSTALL
    if [[ ! "$DO_INSTALL" =~ ^[nN] ]]; then
        exec bash "$SCRIPT_DIR/install.sh"
    fi
    exit 0
fi

# ─── First-Run-Onboarding-Erkennung ──────────────────────────────────
if [[ ! -f "$CONFIG_DIR/.onboarding-done" ]]; then
    echo -e "\n${CYAN}╔══════════════════════════════════════════════════════════╗${NC}"
    echo -e "${CYAN}║  👋 Willkommen! Shinon ist installiert.                  ║${NC}"
    echo -e "${CYAN}║                                                          ║${NC}"
    echo -e "${CYAN}║  Bevor es losgeht, lass uns kurz alles einrichten.       ║${NC}"
    echo -e "${CYAN}║  Das dauert etwa 2 Minuten.                              ║${NC}"
    echo -e "${CYAN}╚══════════════════════════════════════════════════════════╝${NC}"
    echo ""
    read -rp "  Onboarding starten? (J/n): " DO_ONBOARD
    if [[ ! "$DO_ONBOARD" =~ ^[nN] ]]; then
        exec bash "$SCRIPT_DIR/shinon-setup"
    fi
fi

# ─── Hauptmenü ──────────────────────────────────────────────────────
CMD="${1:-help}"

case "$CMD" in
    start)
        bash "$SCRIPT_DIR/ctl" start all
        ;;
    stop)
        bash "$SCRIPT_DIR/ctl" stop all
        ;;
    status)
        bash "$SCRIPT_DIR/ctl" status
        ;;
    restart)
        bash "$SCRIPT_DIR/ctl" stop all 2>/dev/null || true
        sleep 1
        bash "$SCRIPT_DIR/ctl" start all
        ;;
    chat)
        echo -e "\n${BOLD}Shinon Chat${NC}"
        echo "  Starte Komponenten..."
        bash "$SCRIPT_DIR/ctl" start limen 2>/dev/null || true
        bash "$SCRIPT_DIR/ctl" start dashboard 2>/dev/null || true
        echo ""
        echo -e "  ${GREEN}✅${NC} Chat verfügbar unter: ${CYAN}http://127.0.0.1:4200${NC}"
        echo "  (Dashboard mit Chat-Tab öffnen)"
        echo ""
        # Versuche Browser zu öffnen
        if command -v xdg-open &>/dev/null; then
            xdg-open "http://127.0.0.1:4200" 2>/dev/null || true
        elif command -v open &>/dev/null; then
            open "http://127.0.0.1:4200" 2>/dev/null || true
        fi
        ;;
    dashboard)
        bash "$SCRIPT_DIR/ctl" start dashboard 2>/dev/null || true
        echo -e "  Dashboard: ${CYAN}http://127.0.0.1:4200${NC}"
        command -v xdg-open &>/dev/null && xdg-open "http://127.0.0.1:4200" 2>/dev/null || true
        ;;
    keys)
        bash "$SCRIPT_DIR/ctl" start limen 2>/dev/null || true
        echo -e "  Key-Management: ${CYAN}http://127.0.0.1:8000/leitstand${NC}"
        command -v xdg-open &>/dev/null && xdg-open "http://127.0.0.1:8000/leitstand" 2>/dev/null || true
        ;;
    --setup|setup)
        exec bash "$SCRIPT_DIR/shinon-setup"
        ;;
    --doc|doc)
        exec bash "$SCRIPT_DIR/shinon-setup" --doc
        ;;
    help|--help|-h)
        cat << 'HELPEOF'

╔══════════════════════════════════════════════════════════════╗
║  🦇 SHINON — Control Plane CLI                              ║
╚══════════════════════════════════════════════════════════════╝

  Kritisch. Skeptisch. Präzise.
  Dein AI-Control-Center für Prompt-Engineering, 
  API-Management und autonome Entwicklung.

┌─────────────────────────────────────────────────────────────┐
│  Befehle:                                                    │
│                                                              │
│  ./shinon start       Startet alle Komponenten               │
│  ./shinon stop        Stoppt alle Komponenten                │
│  ./shinon status      Zeigt Status aller Komponenten         │
│  ./shinon restart     Neustart                               │
│                                                              │
│  ./shinon chat        Öffnet die Chat-Oberfläche             │
│  ./shinon dashboard   Öffnet das Live-Dashboard              │
│  ./shinon keys        API-Key-Management                     │
│                                                              │
│  ./shinon --setup     Onboarding-Wizard (Ersteinrichtung)    │
│  ./shinon --doc       Doctor Mous · Diagnose & Reparatur     │
│                                                              │
│  ./shinon help        Diese Hilfe                            │
└─────────────────────────────────────────────────────────────┘

HELPEOF
        ;;
    *)
        echo "Unbekannter Befehl: $CMD"
        echo "  ./shinon help  für alle Befehle"
        exit 1
        ;;
esac
